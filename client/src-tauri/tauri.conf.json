{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tebb",
  "version": "0.4.1",
  "identifier": "cn.deskcompanion.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "tebb 小伴",
        "width": 260,
        "height": 380,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "url": "index.html"
      },
      {
        "label": "main",
        "title": "tebb",
        "backgroundColor": "#101216",
        "url": "client.html",
        "width": 1180,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
